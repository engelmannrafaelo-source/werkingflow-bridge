FROM openresty/openresty:1.27.1.1-alpine

# envsubst needed for ${BRIDGE_PROD_HOST}/${BRIDGE_ID} template substitution
# (replicates the nginx:alpine behavior used in the original service)
# perl required by opm package manager.
RUN apk add --no-cache gettext curl perl

# lua-resty-http — used by pool_router.lua to fetch /v1/metrics/account-pool-state.
# VENDORED (docker/lua-vendor/resty, pinned v0.17.2, MIT) instead of a
# build-time curl against raw.githubusercontent.com: der Live-Download hat am
# 31.08.2026 drei --no-cache-Deploys in Folge mit transienten 4xx gekillt
# (auch vom Dev-Server reproduziert). Ein Deploy darf nicht von GitHub-CDN-
# Laune abhaengen. Version-Bump = Dateien in docker/lua-vendor/resty tauschen.
COPY docker/lua-vendor/resty /usr/local/openresty/lualib/resty

# Lua router script baked into image (pool_router.lua + any future helpers)
COPY docker/lua /etc/nginx/lua

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Build provenance: the commit this image was built from. bridge-deploy.sh resolves
# it on the target host and passes it through docker compose; an ad-hoc local build
# leaves "unknown". Deliberately the last layer: a value that changes every deploy
# must not invalidate the cache of everything above it.
ARG GIT_COMMIT=unknown
LABEL bridge.git.commit=$GIT_COMMIT
