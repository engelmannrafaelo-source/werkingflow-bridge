# =============================================================================
# Bridge Metrics Reader — lean, read-only, no Claude CLI, no Anthropic deps.
# =============================================================================
# Purpose: serve historical Bridge metrics from JSONL on disk, surviving
# worker crashes and 503-storms. Mounts the eco-wrapper-logs volume read-only.
# =============================================================================
FROM python:3.12-slim

# Minimal system deps (no build-essential, no curl needed at runtime).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install only what the reader needs. No poetry, no Anthropic, no Presidio.
RUN pip install --no-cache-dir \
    "fastapi>=0.110,<1" \
    "uvicorn[standard]>=0.29,<1"

WORKDIR /app

# Copy the middleware modules the reader depends on.
# These are the SAME files used by the Bridge workers — single source of truth.
# Build context is the bridge repo root (../).
#
# NOTE: We override src/middleware/__init__.py with an EMPTY file because the
# upstream __init__.py imports performance_monitor (which pulls in FastAPI
# middleware plumbing the reader does not need). Keeping it empty isolates
# the reader from worker-only deps.
RUN mkdir -p /app/src /app/src/middleware /app/src/metrics_reader \
    && touch /app/src/__init__.py /app/src/middleware/__init__.py

COPY src/middleware/bridge_metrics_store.py         /app/src/middleware/bridge_metrics_store.py
COPY src/middleware/prompt_metrics.py               /app/src/middleware/prompt_metrics.py
COPY src/middleware/rolling_metrics.py              /app/src/middleware/rolling_metrics.py

# Copy the reader app itself.
COPY src/metrics_reader/__init__.py                 /app/src/metrics_reader/__init__.py
COPY src/metrics_reader/main.py                     /app/src/metrics_reader/main.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    METRICS_DIR=/app/logs \
    LOG_LEVEL=INFO

EXPOSE 8000

# Healthcheck: hits the self /health endpoint (no worker-dep).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.metrics_reader.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "4", "--access-log"]
