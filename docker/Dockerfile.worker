FROM python:3.12-slim

# System deps: Node.js + gosu + WeasyPrint Cairo/Pango stack (NO libgl1/libglib for Docling).
# WeasyPrint (invoice PDF) is a non-optional dep — worker serves invoice endpoints too.
RUN apt-get update && apt-get install -y \
    curl \
    nodejs \
    npm \
    gosu \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for Claude Code (required for bypassPermissions)
RUN useradd -m -u 1001 -s /bin/bash claude

# Install Poetry globally
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=/usr/local python3 -

ENV PATH="/usr/local/bin:${PATH}"

# Install Claude Code CLI globally (for SDK compatibility).
# PINNED on purpose: unpinned, every image rebuild silently pulled the LATEST
# CLI — so ANY deploy (even an unrelated feature) swapped the LLM harness under
# all workers. The 2026-07-06 rebuild bumped 2.1.200→2.1.201 and flipped a
# months-stable prompt behavior, killing energy phase 4 the same evening
# (see commit e898c7c). Bump this version DELIBERATELY: change it here, deploy
# to the dev bridge first, run the smoke + an energy phase-4 style
# tools-disabled call, then roll to prod.
RUN npm install -g @anthropic-ai/claude-code@2.1.220

# Copy the app code
COPY . /app

WORKDIR /app

# Copy SuperClaude Framework plugins and commands for claude user (if available)
RUN mkdir -p /home/claude/.claude/plugins /home/claude/.claude/commands

# Copy container-specific MCP config for claude user
COPY config/docker-claude.json /home/claude/.claude.json

# Create directories for volumes
RUN mkdir -p /app/logs /app/instances

# Install Python deps WITHOUT privacy/pdf extras (core only — lightweight!)
# NO spaCy, NO Presidio, NO Docling, NO PyTorch
# Install from the COMMITTED poetry.lock — reproducible. A `poetry lock` here would
# re-resolve deps on every build and let Dev and Prod drift to DIFFERENT versions
# from the SAME commit (caret ranges in pyproject). To bump deps: run `poetry lock`
# locally, verify a build, commit the new lock. (Mirrors Dockerfile.privacy-pdf.)
RUN poetry config virtualenvs.in-project true && poetry install --no-root

# Set ownership
RUN chown -R claude:claude /app /home/claude

# Copy and set up entrypoint script
COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Container starts as root to fix volume permissions, then drops to claude user
ENTRYPOINT ["docker-entrypoint.sh"]

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["poetry", "run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Build provenance: the commit this image was built from. bridge-deploy.sh resolves
# it on the target host and passes it through docker compose; an ad-hoc local build
# leaves "unknown". Deliberately the last layer: a value that changes every deploy
# must not invalidate the cache of everything above it.
ARG GIT_COMMIT=unknown
LABEL bridge.git.commit=$GIT_COMMIT
