# Load explicitly during the approved deployment, before compose starts.
#include <tunables/global>
profile erkunder-supervisor flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network inet stream,
  network inet6 stream,
  network unix,
  capability sys_admin,
  capability dac_override,
  capability chown,
  capability setuid,
  capability setgid,
  file,
  mount,
  umount,
  pivot_root,
  signal (send,receive) peer=erkunder-supervisor,
  signal (receive) peer=unconfined,
  deny /sys/** wklx,
  deny /proc/sys/** wklx,
  deny /proc/kcore rwklx,
  deny /proc/*/mem rwklx,
  deny /proc/*/root/** rwklx,
  deny /var/run/docker.sock rwklx,
}
