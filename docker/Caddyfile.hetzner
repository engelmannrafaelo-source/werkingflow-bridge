# TLS-Terminator der DEV-Bridge (hetzner, 49.12.72.66) — Caddyfile.
#
# Zweck: BRIDGE_PUBLIC_URL=https://bridge.werking.tools erreichbar machen —
# Mollie akzeptiert nur HTTPS-Webhooks (/v1/billing/mollie-webhook), und ohne
# diesen Terminator gab es auf dem Host keinen 443-Listener: jede Zahlung
# blieb bei Mollie "paid", das Guthaben kam nie an (Befund 02.08.2026).
#
# Caddy holt und erneuert die Let's-Encrypt-Zertifikate selbst (HTTP-01 über
# :80) und wiederholt die Ausstellung automatisch, solange der DNS-Eintrag
# noch fehlt — Deploy darf also VOR dem DNS-Eintrag passieren.
#
# Additiv vor dem bestehenden LB: reine Weiterleitung an den OpenResty-LB
# (Compose-Service `nginx`), KEINE eigene Routing-/Failover-Logik hier.
bridge.werking.tools {
	# ADR-0011: Caddy wohnt im Docker-Netz — sein remote_addr faellt beim LB
	# in den vertrauten Bereich. Ohne diesen Strip koennte JEDER externe
	# HTTPS-Client einen X-Bridge-Origin faelschen und damit umleiten,
	# wessen Budget zahlt. X-Bridge-Hop bleibt durchgelassen; X-Bridge-Edge
	# markiert ihn als von aussen (IDEMR R3).
	reverse_proxy nginx:80 {
		header_up -X-Bridge-Origin
		# IDEMR R3: X-Bridge-Hop passes (werking-energy uses it on purpose to
		# stay on this bridge; harmless without an Idempotency-Key). Caddy sits
		# in the trusted network, so it marks everything it relays from
		# outside: nginx then never takes a relayed hop as trusted, which is
		# what decides the bridge of a keyed job. Set, not add — a client
		# value is overwritten.
		header_up X-Bridge-Edge "1"
	}
}
