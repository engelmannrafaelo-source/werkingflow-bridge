# Minimal Bedrock Service - No Claude Code SDK, just boto3
# Much lighter than main wrapper (~200MB vs ~2GB)

FROM python:3.12-slim

WORKDIR /app

# Install only essential dependencies
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.32.0 \
    boto3>=1.35.0 \
    pydantic>=2.10.0 \
    python-dotenv>=1.0.0

# Create directory structure
RUN mkdir -p /app/src/routing /app/config

# Create __init__.py files
RUN touch /app/src/__init__.py /app/src/routing/__init__.py

# Copy required source files
COPY src/bedrock_service.py /app/src/
COPY src/models.py /app/src/
COPY src/model_registry.py /app/src/
COPY src/auth.py /app/src/
COPY src/routing/backend_router.py /app/src/routing/
COPY config/ /app/config/

EXPOSE 8001

CMD ["uvicorn", "src.bedrock_service:app", "--host", "0.0.0.0", "--port", "8001"]
