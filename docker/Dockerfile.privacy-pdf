FROM python:3.12-slim

# System deps:
#   - libgl1/libglib2.0-0: Docling (OpenCV)
#   - libreoffice headless components: DOCX/PPTX/XLSX legacy → PDF
#   - fonts-*: ensure non-ASCII text renders when LibreOffice rasterises
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    libreoffice-core \
    libreoffice-writer \
    libreoffice-impress \
    libreoffice-calc \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1001 -s /bin/bash claude

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=/usr/local POETRY_VERSION=2.4.1 python3 -

ENV PATH="/usr/local/bin:${PATH}"

# NOTE: No Node.js, no Claude Code CLI — this service has no SDK calls

# Copy the app code
COPY . /app

WORKDIR /app

# Create directories
RUN mkdir -p /app/logs

# Install Python deps WITH privacy + pdf + documents extras.
# documents pulls openpyxl/pandas/tabulate/markdownify/extract-msg so the
# universal /document/convert endpoint can handle XLSX/CSV/HTML/MSG/EML.
# Install from the COMMITTED poetry.lock — reproducible. The previous `poetry
# lock` re-resolved on every build and drifted docling/torch to a CUDA-13 build
# whose nvidia-cudnn-cu13 fails to install. Pinned Poetry (2.4.1, above) +
# committed lock = deterministic. To bump deps: run `poetry lock` locally,
# verify a build, commit the new lock.
RUN poetry config virtualenvs.in-project true && \
    poetry install --no-root --extras "privacy" --extras "pdf" --extras "documents"

# Download spaCy language models for Presidio PII detection
RUN poetry run python -m spacy download de_core_news_lg && \
    poetry run python -m spacy download en_core_web_lg

# Pre-download Docling OCR models (avoids download on first request)
RUN poetry run python -c "\
from docling.document_converter import DocumentConverter; \
from docling.datamodel.pipeline_options import PdfPipelineOptions; \
from docling.datamodel.base_models import InputFormat; \
from docling.document_converter import PdfFormatOption; \
opts = PdfPipelineOptions(); \
opts.generate_picture_images = True; \
opts.do_ocr = True; \
converter = DocumentConverter(format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)}); \
print('Docling models downloaded successfully') \
" || echo "WARNING: Docling model pre-download failed (will download on first use)"

# Playwright + Chromium für den HTML→PDF-Renderer (/convert-html-to-pdf).
# Per pip installiert (NICHT via poetry), um die committete poetry.lock NICHT
# neu aufzulösen — ein `poetry lock` hat docling/torch schon auf einen kaputten
# CUDA-13-Build gedriftet (siehe oben). Das Browser-Binary geht nach
# /ms-playwright (ENV persistiert → der non-root 'claude'-Runtime-User findet es).
#
# WICHTIG: NICHT `playwright install --with-deps` — dessen apt-Liste enthält
# Ubuntu-only/obsolete Font-Pakete (ttf-unifont, ttf-ubuntu-font-family), die auf
# debian-slim fehlen → apt exit 100 → Build-Fail. Stattdessen die echten Chromium-
# Runtime-Libs explizit (existieren auf bookworm-slim); Fonts sind oben schon da.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxcb1 libxkbcommon0 libatspi2.0-0 libx11-6 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/* \
    && poetry run pip install --no-cache-dir playwright==1.49.1 \
    && poetry run playwright install chromium \
    && chmod -R a+rx /ms-playwright

# Set ownership
RUN chown -R claude:claude /app /home/claude

USER claude

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8100/health || exit 1

# UVICORN_WORKERS env var controls process pool size (default 1 for backwards compat).
# Each worker loads spaCy + Presidio + Docling models into memory (~2-3 GiB),
# so size according to host RAM. Set DOCLING_THREADS for per-PDF parallelism.
CMD ["sh", "-c", "poetry run uvicorn src.privacy_service.app:app --host 0.0.0.0 --port 8100 --workers ${UVICORN_WORKERS:-1}"]
