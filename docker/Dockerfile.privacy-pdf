FROM python:3.12-slim

# TORCH_VARIANT selects the torch/torchvision wheels installed below.
#   cpu  (default): unchanged CPU-only build — every host builds this today.
#   cuda: pulls PyPI's default (CUDA-enabled) wheels for the SAME pinned
#         versions instead of the +cpu ones, for GPU hosts running Flair
#         inference on an NVIDIA GPU via nvidia-container-toolkit. No CUDA
#         toolkit/base image needed — the cu-enabled torch wheel bundles its
#         own CUDA runtime libs (nvidia-cublas-cu12 etc. as pip deps); the
#         host only needs a driver + nvidia-container-toolkit.
#   Build with: docker build --build-arg TORCH_VARIANT=cuda ...
#   Does NOT touch poetry.lock or the poetry install step either way — see
#   the note on the pip-installed torch/flair block below.
ARG TORCH_VARIANT=cpu

# System deps:
#   - libgl1/libglib2.0-0: Docling (OpenCV)
#   - libreoffice headless components: DOCX/PPTX/XLSX legacy → PDF
#   - fonts-*: ensure non-ASCII text renders when LibreOffice rasterises
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    libreoffice-core \
    libreoffice-writer \
    libreoffice-impress \
    libreoffice-calc \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1001 -s /bin/bash claude

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=/usr/local POETRY_VERSION=2.4.1 python3 -

ENV PATH="/usr/local/bin:${PATH}"

# NOTE: No Node.js, no Claude Code CLI — this service has no SDK calls

# Copy the app code
COPY . /app

WORKDIR /app

# Create directories
RUN mkdir -p /app/logs

# Install Python deps WITH privacy + pdf + documents extras.
# documents pulls openpyxl/pandas/tabulate/markdownify/extract-msg so the
# universal /document/convert endpoint can handle XLSX/CSV/HTML/MSG/EML.
# Install from the COMMITTED poetry.lock — reproducible. The previous `poetry
# lock` re-resolved on every build and drifted docling/torch to a CUDA-13 build
# whose nvidia-cudnn-cu13 fails to install. Pinned Poetry (2.4.1, above) +
# committed lock = deterministic. To bump deps: run `poetry lock` locally,
# verify a build, commit the new lock.
RUN poetry config virtualenvs.in-project true && \
    poetry install --no-root --extras "privacy" --extras "pdf" --extras "documents"

# Download spaCy language models. de_core_news_lg now only TOKENISES for
# Presidio (its NER is removed in anonymizer.py); Flair owns name detection.
RUN poetry run python -m spacy download de_core_news_lg && \
    poetry run python -m spacy download en_core_web_lg

# Flair NER (local German PERSON/LOCATION/ORG detection) — replaces spaCy's
# over-eager NER. Installed via pip (NOT poetry) to avoid re-resolving the
# committed poetry.lock, which drifts torch to a broken CUDA build (see note
# above). CPU build (default) pins the +cpu wheel: CPU-only host, the default
# CUDA build is ~2 GB larger and pulls nvidia-cudnn which fails to install
# here. torchvision MUST be pinned to the version matching torch 2.5.1
# (0.20.1) too: flair otherwise pulls torchvision 0.27.0 (built for torch
# 2.12), whose C++ ops (torchvision::nms) then fail against torch 2.5.1 —
# that ABI break surfaces as transformers' lazy LayoutLMv2/AutoProcessor
# imports crashing, which takes down BOTH flair NER and docling OCR (both do
# `from transformers import`).
#
# TORCH_VARIANT=cuda (see ARG above) installs the SAME pinned 2.5.1/0.20.1
# versions but the default (CUDA-enabled) PyPI wheels instead of +cpu — those
# bundle CUDA 12.4 runtime libs as pip deps (nvidia-cublas-cu12 etc.), which
# is the known-good pairing for this torch version, not the newer cu13 build
# that broke `poetry lock` (see note above). Runtime still needs a host GPU +
# nvidia-container-toolkit; the build itself does not require one.
RUN if [ "$TORCH_VARIANT" = "cuda" ]; then \
        poetry run pip install --no-cache-dir \
            "torch==2.5.1" "torchvision==0.20.1" "flair==0.15.1"; \
    elif [ "$TORCH_VARIANT" = "cpu" ]; then \
        poetry run pip install --no-cache-dir \
            --extra-index-url https://download.pytorch.org/whl/cpu \
            "torch==2.5.1+cpu" "torchvision==0.20.1+cpu" "flair==0.15.1"; \
    else \
        echo "Unknown TORCH_VARIANT='$TORCH_VARIANT' — expected 'cpu' or 'cuda'" >&2; \
        exit 1; \
    fi

# Pre-download the Flair model (~1.5 GB) so the first request doesn't block on a
# download and the service works without network at runtime.
RUN poetry run python -c "from flair.models import SequenceTagger; SequenceTagger.load('flair/ner-german-large'); print('Flair model downloaded')" \
    || echo "WARNING: Flair model pre-download failed (will download on first use)"

# Pre-download Docling OCR models (avoids download on first request)
RUN poetry run python -c "\
from docling.document_converter import DocumentConverter; \
from docling.datamodel.pipeline_options import PdfPipelineOptions; \
from docling.datamodel.base_models import InputFormat; \
from docling.document_converter import PdfFormatOption; \
opts = PdfPipelineOptions(); \
opts.generate_picture_images = True; \
opts.do_ocr = True; \
converter = DocumentConverter(format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)}); \
print('Docling models downloaded successfully') \
" || echo "WARNING: Docling model pre-download failed (will download on first use)"

# Playwright + Chromium für den HTML→PDF-Renderer (/convert-html-to-pdf).
# Per pip installiert (NICHT via poetry), um die committete poetry.lock NICHT
# neu aufzulösen — ein `poetry lock` hat docling/torch schon auf einen kaputten
# CUDA-13-Build gedriftet (siehe oben). Das Browser-Binary geht nach
# /ms-playwright (ENV persistiert → der non-root 'claude'-Runtime-User findet es).
#
# WICHTIG: NICHT `playwright install --with-deps` — dessen apt-Liste enthält
# Ubuntu-only/obsolete Font-Pakete (ttf-unifont, ttf-ubuntu-font-family), die auf
# debian-slim fehlen → apt exit 100 → Build-Fail. Stattdessen die echten Chromium-
# Runtime-Libs explizit (existieren auf bookworm-slim); Fonts sind oben schon da.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxcb1 libxkbcommon0 libatspi2.0-0 libx11-6 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/* \
    && poetry run pip install --no-cache-dir playwright==1.49.1 \
    && poetry run playwright install chromium \
    && chmod -R a+rx /ms-playwright

# Set ownership
RUN chown -R claude:claude /app /home/claude

USER claude

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8100/health || exit 1

# UVICORN_WORKERS env var controls process pool size (default 1 for backwards compat).
# Each worker loads spaCy + Presidio + Docling models into memory (~2-3 GiB),
# so size according to host RAM. Set DOCLING_THREADS for per-PDF parallelism.
CMD ["sh", "-c", "poetry run uvicorn src.privacy_service.app:app --host 0.0.0.0 --port 8100 --workers ${UVICORN_WORKERS:-1}"]

# Build provenance: the commit this image was built from. bridge-deploy.sh resolves
# it on the target host and passes it through docker compose; an ad-hoc local build
# leaves "unknown". Deliberately the last layer: a value that changes every deploy
# must not invalidate the cache of everything above it.
ARG GIT_COMMIT=unknown
LABEL bridge.git.commit=$GIT_COMMIT
