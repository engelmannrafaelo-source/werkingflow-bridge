# =============================================================================
# EDEAIBridge Environment Configuration - EXAMPLE
# =============================================================================
#
# Copy this file to .env and fill in your values.
#
# For production deployments on Hetzner:
# - Credentials are stored in the Control Center Vault
# - Auto-distributed via deployment pipeline
# - See: https://werkflow.at/control-center/credentials
#
# =============================================================================

# TAVILY API Key (Required for /v1/research endpoint)
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=tvly-your-api-key-here

# Hetzner Cloud API Token (for /v1/hetzner/* endpoints)
# Get your token at: https://console.hetzner.cloud → Security → API Tokens
HETZNER_API_TOKEN=your-hetzner-api-token-here

# Anthropic API Key (REQUIRED for Vision/Image Analysis)
# OAuth doesn't support multimodal - images require direct API access
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Server Configuration
PORT=8000
LOG_LEVEL=INFO

# System-Health: App-Probes (/v1/system/health). Optional je App (APP = WERKING_ENERGY, ...).
# Eigene Domain statt *.vercel.app, und/oder Vercel-Schutz-Bypass als Header.
# APP_HEALTH_BASE_WERKING_ENERGY=https://energy.example.com
# APP_HEALTH_BYPASS_WERKING_ENERGY=

# Pipeline attempt identity + public job lookup (opt-in after complete rollout).
# Worker env_file; does not disable the pre-existing Idempotency-Key contract.
BRIDGE_JOB_ATTEMPT_IDENTITY_ENABLED=false

# Test-KI-Deckel: echte KI fuer Testaufrufe von werking-works und werking-report,
# NUR Haiku-Chat (claude-haiku-5-5, Direktweg), gedeckelt 0,50 EUR je Lauf / 10 EUR
# je App und UTC-Tag / 20 EUR gesamt je UTC-Tag, fail-closed; jeder andere Weg 403.
# Testaufruf = Prinzipal aus TEST_KI_PRINZIPALE (kommagetrennte
# service_principals.name), Job eines solchen Prinzipals, oder Kopf X-Test-Lauf.
# Nur auf der Dev-Bridge "1" (docker-compose.yml). Schalter aus + Testaufruf = 403
# KI_TEST_DECKEL_INAKTIV. Braucht Migration 072. Vertrag:
# docs/contracts/test-ki-deckel.md. Kein Secret.
BRIDGE_TEST_KI_DECKEL=0
BRIDGE_TEST_KI_PRINZIPALE=

# Erkunder: inactivity since last SDK event, never total step/job duration.
ERKUNDER_STILLE_S=1800
